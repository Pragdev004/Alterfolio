# Alterfolio V2 local settings template. Copy to backend/.env (git-ignored) and fill in; never commit real values.

# --- App settings (app/config.py, prefix ALTERFOLIO_) ---
# ALTERFOLIO_DATABASE_URL=postgresql+psycopg://user:password@localhost:5432/alterfolio

# --- AI analyst (app/analyst/settings.py: the process env wins over this file; a blank value counts as unset) ---
# none (default, offline template) | openai_compatible | langchain
AI_PROVIDER=none
# langchain: <provider>:<model>, e.g. groq:qwen/qwen3.8-27b, groq:llama-3.1-8b-instant, openai:<model>
# AI_MODEL=groq:qwen/qwen3.8-27b
# Key for the provider; if unset the provider's own variable is used (GROQ_API_KEY, OPENAI_API_KEY, ...)
# AI_API_KEY=
# OpenRouter or another OpenAI-compatible endpoint (use AI_MODEL=openai:<model>), e.g. https://openrouter.ai/api/v1
# AI_BASE_URL=
# qwen3 and other reasoning models: "none" keeps output tokens low; unset = provider default
# AI_REASONING_EFFORT=none
# AI_TIMEOUT_SECONDS=30
# AI_MAX_RETRIES=2
# Input + output tokens allowed per question
# AI_TOKEN_BUDGET=4000
# 0 = do not request JSON mode for the routing plan (for providers that reject response_format)
# AI_JSON_MODE=1
